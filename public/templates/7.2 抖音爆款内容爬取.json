    {
      "parameters": {
        "jsCode": "// --- 辅助函数：将毫秒转换为 \"分:秒\" 格式 ---\n// (这部分代码保持不变)\nfunction formatDuration(ms) {\n  // 检查输入是否有效，无效则返回 'N/A'\n  if (!ms || typeof ms !== 'number' || ms < 0) {\n    return \"N/A\"; \n  }\n  \n  // 1. 将毫秒转换为总秒数\n  const totalSeconds = Math.floor(ms / 1000);\n  \n  // 2. 从总秒数中计算分钟数\n  const minutes = Math.floor(totalSeconds / 60);\n  \n  // 3. 计算剩余的秒数\n  const seconds = totalSeconds % 60;\n  \n  // 4. 格式化：确保分钟和秒都是两位数 (例如 05:09)\n  const formattedMinutes = String(minutes).padStart(2, '0');\n  const formattedSeconds = String(seconds).padStart(2, '0');\n  \n  // 5. 返回 \"MM:SS\" 格式的字符串\n  return `${formattedMinutes}:${formattedSeconds}`;\n}\n\n// --- 主脚本 ---\n\n// 1. 获取上一个节点传来的 items 数组\nconst allItems = $json.data.items;\n\n// 2. 创建一个新数组来存放处理后的结果\nconst outputItems = [];\n\n// 3. 遍历 allItems 数组中的每一个 item\nfor (const item of allItems) {\n  \n  // 4. 构建你想要的干净数据结构\n  const newItem = {\n    json: {\n      \"视频标题\": item.title,\n      \"视频链接\": item.shareUrl,\n      \"博主名称\": item.nickname,\n      \"博主主页\": item.userShareUrl,\n      \"点赞数\": item.digg_count,\n      \"收藏数\": item.collect_count,\n      \"评论数\": item.comment_count,\n      \"分享数\": item.share_count,\n      \"发布时间\": item.post_time,\n      \n      // --- 这里是为你修改的字段 ---\n      \"视频时长\": formatDuration(item.duration), // 1. 保留格式化后的 \"MM:SS\" 时长\n      \"原始视频时长\": item.duration // 2. 新增：加回原始的毫秒数时长\n    }\n  };\n  \n  // 5. 将这个新 item 添加到输出数组中\n  outputItems.push(newItem);\n}\n\n// 6. 把包含10个 item 的新数组返回给 n8n\nreturn outputItems;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
