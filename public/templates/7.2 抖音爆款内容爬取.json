    {
      "parameters": {
        "jsCode": "// 获取所有输入项目\nconst items = $input.all();\n\n// 遍历所有项目 (在您的情况下，只有一个控制项目)\nreturn items.map(item => {\n  \n  let newCount;\n  \n  // 从 item.json 中获取当前的 count 值 (它可能是 \"10\")\n  const currentCount = item.json.count;\n\n  // 1. 检查 'count' 字段是否存在 (无论是数字还是字符串)\n  if (item.json && currentCount !== undefined) {\n    \n    // 2. 将其强制转换为数字，然后加 10\n    // Number(\"10\") 会得到 10\n    // Number(10) 也会得到 10\n    // 10 + 10 = 20\n    newCount = Number(currentCount) + 10;\n\n  } else {\n    // 3. 如果 count 字段不存在 (即第一次循环)，则起始值为 10\n    newCount = 10;\n  }\n  \n  // 4. 将计算出的新值 (例如 20) 写回 'count' 字段\n  item.json.count = newCount;\n  \n  // 5. 返回修改后的项目\n  return item;\n});"
      },
