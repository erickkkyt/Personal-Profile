      ],
      "id": "41403a0d-04b1-4369-8523-b5099c10816e",
      "name": "数据清洗"
    },
    {
      "parameters": {
        "jsCode": "/*\n * ----------------------------------------------------\n * n8n \"Code\" 节点：数据清理 (N-to-N 流程)\n * ----------------------------------------------------\n * 功能：\n * 1. 接收上一个节点传来的 10 个抖音 item。\n * 2. 对指定的文本字段进行“清理”（转义特殊字符）。\n * 3. 返回 *同样多的* (10个) 清理后的 item。\n * ----------------------------------------------------\n */\n\n// 1. 获取上一个节点传入的所有 (10个) 数据项\nconst items = $input.all();\n\n// 2. --- 在这里指定需要处理的字段名 ---\n// (你上一个节点输出的字段名)\nconst fieldsToClean = [\n  '视频标题',\n  '博主名称',\n  '博主主页',\n  '发布时间'\n  // '视频链接' 和 '视频时长' 不是纯文本，通常不需要清理\n];\n\n// 3. 使用 .map() 来遍历所有 item\n//    这是你 V2 代码中的逻辑，n8n v1+ 会自动将返回的数组“展开”为 10 个 item\nreturn items.map(item => {\n  \n  // 4. 遍历需要清理的字段\n  for (const field of fieldsToClean) {\n    \n    // 5. 检查字段是否存在并且它是一个字符串\n    if (item.json[field] && typeof item.json[field] === 'string') {\n      \n      // 6. 这是你提供的“清理”逻辑，完全正确！\n      //    它会转义 \"、\\n (换行) 等\n      item.json[field] = JSON.stringify(item.json[field]).slice(1, -1);\n    }\n  }\n  \n  // 7. 返回这个被修改过的 item\n  return item;\n});"
      },
