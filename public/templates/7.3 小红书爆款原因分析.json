      "parameters": {
        "jsCode": "// 获取所有项的 text 字段\nlet allText = items\n  .map(item => {\n    // text 节点输出有时是 text 或 item.json.text，需要兼容\n    return item.json.text || item.json['text[0]'] || item.json['text[1]'] || \"\";\n  })\n  .join(\"\\n\\n\");\n\n// 返回合并后的单个 item\nreturn [{\n  json: {\n    text: allText\n  }\n}];"
      },
