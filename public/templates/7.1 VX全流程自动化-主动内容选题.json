      "parameters": {
        "jsCode": "// 获取上游AI节点返回的、可能不规整的原始字符串\nconst rawString = items[0].json.output;\n\n// 使用正则表达式，匹配并提取出第一个'{'和最后一个'}'之间的所有内容\n// 's'标志让'.'可以匹配包括换行符在内的任意字符，非常重要\nconst jsonMatch = rawString.match(/{.*}/s);\n\n// 检查是否成功找到了JSON部分\nif (jsonMatch && jsonMatch[0]) {\n  // 这是我们提取出的、相对干净的JSON字符串\n  const cleanJsonString = jsonMatch[0];\n  \n  try {\n    // 解析这个干净的JSON字符串\n    const parsedData = JSON.parse(cleanJsonString);\n    \n    // 构建一个全新的、只包含我们需要的两个字段的输出对象\n    const finalOutput = {\n      json: {\n        StrategicLevel: parsedData.StrategicLevel,\n        UserPersona: parsedData.UserPersona\n      }\n    };\n    \n    // 将最终结果返回给下一个节点\n    return finalOutput;\n    \n  } catch (error) {\n    // 如果解析仍然失败，返回错误信息，方便排查\n    console.error(\"解析提取出的JSON时失败:\", error);\n    return { json: { error: \"解析提取出的JSON失败\", extracted_string: cleanJsonString } };\n  }\n  \n} else {\n  // 如果在原始字符串中完全找不到'{...}'结构，同样返回错误\n  console.error(\"在AI输出中未找到JSON对象。\");\n  return { json: { error: \"在AI输出中未找到JSON对象\", raw_string: rawString } };\n}"
