    {
      "parameters": {
        "jsCode": "// n8n Code node（Run Once for All Items）\nconst obj = items[0].json;\n\n// 取出原始值：可能是字符串化的数组，也可能就是数组\nlet raw = obj['图片链接'] ?? obj.images ?? obj.urls ?? obj;\n\n// 统一转成数组\nlet urls;\nif (typeof raw === 'string') {\n  try {\n    urls = JSON.parse(raw);         // 处理 \"[...]\" 这种 JSON 字符串\n  } catch (e) {\n    // 如果是用逗号拼的纯文本，也做个兜底拆分\n    urls = raw.split(/\\s*,\\s*/).filter(Boolean);\n  }\n} else {\n  urls = raw;\n}\n\n// 校验\nif (!Array.isArray(urls)) {\n  throw new Error('输入不是数组，请确认上个节点输出的是图片链接数组或其JSON字符串');\n}\n\n// 拆成多个 item\nreturn urls.map((url, idx) => ({\n  json: {\n    index: idx,\n    image_url: url\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -144
      ],
      "id": "9f8eddf7-3bbb-4167-8bd1-30f3f7bb7073",
      "name": "提取链接"
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const url = item.json.image_url || \"\";\n  // 把 /format/heif/ 或 /format/heic/ 改为 /format/png/\n  item.json.image_url_png = url\n    .replace(\"/format/heif/\", \"/format/png/\")\n    .replace(\"/format/heic/\", \"/format/png/\");\n}\n\nreturn $input.all();"
      },
